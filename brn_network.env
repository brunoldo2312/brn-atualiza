# ============================================================
# brn_network.env — Config do nó BRN (Máquina B - Windows)
# Cliente / Pool Worker
# ============================================================

# 1) SEGREDOS COMPARTILHADOS (IGUAIS NAS DUAS MÁQUINAS)
BRN_NETWORK_SECRET=9226edea8ba62bc1c6ae36883c0536c95b4c85642195465d6c4d9456abef20f9
BRN_NODE_PASSWORD=senha-no-temp-123
BRN_WALLET_SESSION_PASS=senha-forte-da-carteira-2026
BRN_WEB_PASS=senha-temp-123

# 2) ADMIN TOKEN
BRN_ADMIN_TOKEN=c745d36d524ea92148d8139731ad663f929fbbe08fb7f9b2234f9109fe1d2b24

# 3) REDE P2P (IP DO UBUNTU)
BRN_BOOTSTRAP_PEERS=100.111.253.8:6001
BRN_TRACKER=
BRN_RENDEZVOUS_URL=

# 4) ENDEREÇOS DE API E POOL
BRN_API_BASE=http://127.0.0.1:5000
BRN_POOL_URL=http://100.111.253.8:5000

# 5) MODO DE OPERAÇÃO (CLIENTE)
BRN_IS_ORIGIN=0
BRN_ALL_MINERS=0
BRN_AUTO_MINE=0
BRN_POOL_ENABLED=0 

# 6) CONSENSO E DIFICULDADE
BRN_SYNC_BATCH=50
BRN_SYNC_BATCH_DELAY=0.06
BRN_SYNC_INTERVAL=5
BRN_MIN_DIFFICULTY=5
BRN_MAX_DIFFICULTY=8

# 7) P2P
BRN_P2P_PORT=6001
BRN_P2P_AUTH=optional
BRN_P2P_AUTH_WINDOW=30
BRN_P2P_NONCE_CACHE=10000
BRN_RATE_LIMIT=200
BRN_UPNP=0
BRN_TCP_TIMEOUT=10.0

# 8) MINERAÇÃO
BRN_MINER_INTERVAL=30
BRN_ALLOW_SOLO_MINING=0
BRN_MIN_PEER_STABLE=1

# 9) HTTP / API (Tailscale escutando todos)
BRN_WEB_HOST=0.0.0.0
BRN_WEB_PORT=5000
BRN_EXPLORER_PORT=8080
BRN_EXPLORER_HOST=0.0.0.0
BRN_HTTP_THREADS=16
BRN_CORS_ORIGIN=*
BRN_BEHIND_PROXY=0
BRN_HTTPS=0

# 10) AUDIT / VERIFY / LOGS
BRN_AUDIT_ENABLED=1
BRN_AUDIT_LOG=audit.log
BRN_AUDIT_MAX_BYTES=52428800
BRN_SKIP_VERIFY=0
BRN_VERIFY_STRICT=0
BRN_LOG_LEVEL=INFO

# 11) TAILSCALE
TS_AUTH_KEY=keBGtiE91d11CNTRL

# 12) PYTHON
PYTHONUNBUFFERED=1

BRN_CHECKPOINT_INTERVAL=100

